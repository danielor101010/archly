# ── Archly server environment ───────────────────────────────────────────────────
# Copy to `.env` and fill in real values. Required vars are validated at boot —
# the process exits with a clear message if any are missing.

# ── Required ─────────────────────────────────────────────────────────────────────
# Supabase project URL (e.g. https://xxxx.supabase.co)
SUPABASE_URL=
# Supabase service-role key (server-side only — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=
# Google OAuth client ID used to verify sign-in credentials
GOOGLE_CLIENT_ID=
# Strong, unique secret for signing session tokens. MUST NOT be the dev default.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# ── AI / email (warn-only: app boots without these, features degrade) ────────────
# Generic LLM API key — takes precedence if set. Use this for any OpenAI-compatible
# provider (Groq, Gemini, DeepSeek, OpenRouter, …) without touching the keys below.
LLM_API_KEY=
# DeepSeek API key — used if LLM_API_KEY is unset (default provider)
DEEPSEEK_API_KEY=
# LLM provider base URL + model. Defaults target DeepSeek; override to switch
# providers, e.g. Groq: LLM_BASE_URL=https://api.groq.com/openai/v1 +
# LLM_MODEL=llama-3.3-70b-versatile  (Gemini/OpenRouter also work here).
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Legacy OpenRouter key — used as a fallback LLM key if DEEPSEEK_API_KEY is unset
OPENROUTER_API_KEY=
# Brevo (Sendinblue) API key — sends welcome emails
BREVO_API_KEY=
# From-address for outgoing email
BREVO_SENDER_EMAIL=danior878@gmail.com

# ── Networking ───────────────────────────────────────────────────────────────────
# Exact origin of the deployed client, added to the CORS allowlist.
# In production this MUST be set (localhost origins are always allowed).
CLIENT_URL=
# Port the HTTP + WebSocket server listens on
PORT=3001

# ── Cost & rate-limit controls ───────────────────────────────────────────────────
# Global daily LLM spend cap (USD). When exceeded, all LLM endpoints short-circuit.
MAX_DAILY_COST_USD=5
# Blended price-per-1k-tokens estimate (input+output). DeepSeek is cheaper, so this
# default over-estimates spend, which keeps the cost breaker on the safe side.
LLM_PRICE_PER_1K_USD=0.001
# Max LLM-triggering actions per user per minute
LLM_RATE_LIMIT_PER_MIN=15
# Max sign-in (POST /api/auth/google) attempts per IP per minute
AUTH_RATE_LIMIT_PER_MIN=10
# Max new WebSocket connections per IP per minute
WS_CONNECT_RATE_LIMIT_PER_MIN=30
# In-memory session eviction age (hours of inactivity)
SESSION_TTL_HOURS=2
