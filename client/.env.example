# ── Archly client environment ───────────────────────────────────────────────────
# Copy to `.env` and fill in real values for local dev. In production these are
# set in Vercel's Environment Variables (build-time — a redeploy is required
# after changing any of these, since Vite inlines them at build time).

# Server URLs the client talks to.
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws

# Google OAuth client ID used to render Sign-In. Must also be added to
# "Authorized JavaScript origins" in the Google Cloud Console for whatever
# origin the client is served from.
VITE_GOOGLE_CLIENT_ID=

# Lemon Squeezy checkout links for the Pro plan (monthly) and the quarterly
# "Interview Sprint". Leave unset and the Pricing page shows "Coming soon"
# instead of a broken checkout link. See PricingPage.tsx — the user's id is
# appended as checkout custom data so the webhook can map the resulting
# subscription back to them; do not include query params of your own here.
VITE_CHECKOUT_URL_MONTHLY=
VITE_CHECKOUT_URL_QUARTERLY=
